{
  "manifest_version": 3,
  "name": "outlook-cli",
  "version": "0.5.0",
  "description": "Use the Office Copilot bridge and export Microsoft Teams transcripts from Chrome.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms", "activeTab", "downloads", "clipboardWrite"],
  "action": {
    "default_title": "outlook-cli: Export Teams transcript",
    "default_icon": {
      "16": "transcript/icons/icon-16.png",
      "32": "transcript/icons/icon-32.png"
    },
    "default_popup": "transcript/popup.html"
  },
  "icons": {
    "16": "transcript/icons/icon-16.png",
    "32": "transcript/icons/icon-32.png",
    "48": "transcript/icons/icon-48.png",
    "128": "transcript/icons/icon-128.png"
  },
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://*.officeapps.live.com/*",
    "https://*.resources.office.net/*",
    "https://*.cloud.microsoft/*"
  ],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://*.officeapps.live.com/*"],
      "js": ["adapters/common.js", "adapters/excel.js", "adapters/powerpoint.js", "hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.sharepoint.com/*",
        "https://*.officeapps.live.com/*",
        "https://*.resources.office.net/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["diagnostics.js", "controller.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
