{
  "manifest_version": 3,
  "name": "outlook-cli Copilot bridge",
  "version": "0.4.0",
  "description": "Lets outlook-cli send prompts to Copilot in Excel, PowerPoint and Word for the web, in your own browser session.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://*.officeapps.live.com/*",
    "https://*.resources.office.net/*",
    "https://*.cloud.microsoft/*"
  ],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://*.officeapps.live.com/*"],
      "js": ["adapters/common.js", "adapters/excel.js", "adapters/powerpoint.js", "hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.sharepoint.com/*",
        "https://*.officeapps.live.com/*",
        "https://*.resources.office.net/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["diagnostics.js", "controller.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
